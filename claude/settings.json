{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "extraKnownMarketplaces": {
    "lee-claude": {
      "source": {
        "source": "github",
        "repo": "leewilson86/claude-marketplace"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "lw-core@lee-claude": true,
    "lw-safety@lee-claude": true,
    "lw-personal@lee-claude": true
  }
}
